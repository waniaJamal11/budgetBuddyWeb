<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Transactions - Budget Buddy</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/categoryStyle.css">



</head>

<body>
    <%- include("../partials/flashMessages.ejs") %>
        <%- include("../partials/navbar.ejs") %>

            <main class="container my-4">
                <div class="row mb-3">
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center">
                            <h2 class="fw-bold text-blue headingSize">Transactions</h2>

                            <!-- ---------------------search------------------------- -->
                            <div class="search-wrapper">
                                <form class="search-form" method="GET" action="/transaction">
                                    <div class="dropdown filter-dropdown">
                                        <button class="filter-btn" type="button" id="filterMenuButton">
                                            <i class="bi bi-filter"></i> Filter
                                        </button>
                                        <ul class="searchDropdown-menu" id="filterMenu">
                                            <li data-value="category">Category</li>
                                            <li data-value="date">Date</li>
                                            <li data-value="type">Type</li>
                                        </ul>
                                    </div>
                                    <input type="hidden" name="filter" id="filterInput" value="<%= filter || '' %>">
                                    <div class="search-input-wrapper">
                                        <input id="searchInput" type="<%= filter === 'date' ? 'date' : 'text' %>"
                                            name="search"
                                            placeholder="<%= filter === 'date' ? 'Select date' : 'Search here...' %>"
                                            value="<%= search || '' %>">
                                    </div>
                                    <button type="submit" class="searchbtn">Search</button>
                                </form>
                            </div>


                            <!------------------------------------------------------>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light table-custom-heading">
                                    <tr>
                                        <th></th>
                                        <th>Category Name</th>
                                        <th>Transaction Type</th>
                                        <th>Amount</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if(transaction.length>0){ %>
                                        <% transaction.forEach(function(transaction, index){ %>
                                            <tr>
                                                <td>
                                                    <%= index+1 %>
                                                </td>
                                                <td>
                                                    <%= transaction.categoryId.name %>
                                                </td>
                                                <td>
                                                    <%= transaction.transactionTypeId.name %>
                                                </td>
                                                <td>
                                                    <%= transaction.amount %>
                                                </td>
                                                <td>
                                                    <!-- View Button -->
                                                    <button class="btn btn-sm btn-primary view-btn"
                                                        data-amount="<%= transaction.amount %>"
                                                        data-categoryname="<%= transaction.categoryId.name %>"
                                                        data-type="<%= transaction.transactionTypeId.name %>"
                                                        data-description="<%= transaction.description %>"
                                                        data-created="<%= moment(transaction.createdAt).format('DD-MMM-YYYY, h:mm A') %>"
                                                        data-updated="<%= moment(transaction.updatedAt).format('DD-MMM-YYYY, h:mm A') %>">
                                                        <i class="bi bi-eye"></i>
                                                    </button>

                                                    <!-- Edit Button -->
                                                    <button class="btn btn-sm btn-primary edit-btn"
                                                        data-id="<%= transaction._id %>"
                                                        data-amount="<%= transaction.amount %>"
                                                        data-categoryid="<%= transaction.categoryId._id %>"
                                                        data-description="<%= transaction.description %>"
                                                        data-categoryname="<%= transaction.categoryId.name %>"
                                                        data-type="<%= transaction.transactionTypeId.name %>">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>

                                                    <!-- Delete Button -->
                                                    <form action="/deleteTransaction/<%= transaction._id %>"
                                                        method="post" style="display: inline-block;">
                                                        <button type="submit" class="btn btn-sm btn-danger delete-btn"
                                                            data-type="transaction"
                                                            data-name="<%= transaction.categoryId.name %>">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                            <% }); %>
                                                <% }else{ %>
                                                    <% if (transaction.length===0) { %>
                                                        <tr>
                                                            <td colspan="8" class="text-center py-4">
                                                                <p class="text-danger mb-3">
                                                                    <%= message %>
                                                                </p>

                                                                <% if (flag===1) { %>
                                                                    <a href="/addTransaction"
                                                                        class="searchbtn d-inline-block"
                                                                        style="border: none; text-decoration: none; margin: 0 auto;">
                                                                        + Add Transaction
                                                                    </a>
                                                                    <% } %>

                                                            </td>
                                                        </tr>
                                                        <% } %>
                                                            <% } %>


                            </table>
                            <%-include("editTransaction.ejs") %>
                                <%-include("viewTransaction.ejs") %>

                        </div>
                    </div>
                </div>
                <%-include("../categoriesPage/deleteCategory.ejs") %>
            </main>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
            <script src="/js/script.js"></script>
            <script src="/js/transactionScript.js"></script>
    
</body>

</html>