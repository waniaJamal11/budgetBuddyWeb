<!-- View Transaction Popup -->
<div id="viewTransactionBox" class="confirm-box-overlay">
  <div class="confirm-box card-popup">
    <h4 class="popup-heading">Transaction Details</h4>

    <div class="transaction-details">
      <div class="detail-row">
        <span class="label">Amount:</span>
        <span class="value" id="viewAmount"></span>
      </div>
      <div class="detail-row">
        <span class="label">Category:</span>
        <span class="value" id="viewCategory"></span>
      </div>
      <div class="detail-row">
        <span class="label">Type:</span>
        <span class="value" id="viewType"></span>
      </div>
      <div class="detail-row">
        <span class="label">Description:</span>
        <span class="value text-break text-end" id="viewDescription"></span>
      </div>
      <div class="detail-row">
        <span class="label">Occurred On:</span>
        <span class="value" id="viewCreated"></span>
      </div>
      <div class="detail-row">
        <span class="label">Last Updated:</span>
        <span class="value" id="viewUpdated"></span>
      </div>
    </div>

    <div class="confirm-buttons text-end mt-3">
      <button type="button" id="viewClose" class="searchbtn">Close</button>
    </div>
  </div>
</div>
