<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Budget Buddy</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/loginStyle.css">
</head>

<body class="bg d-flex align-items-center justify-content-center min-vh-100">

  <%-include("../partials/flashMessages.ejs") %>
    <div id="logo-loader">
      <img src="/images/logo.png" alt="Budget Buddy Logo" class="loader-logo">
    </div>
    <div class="container d-flex flex-wrap align-items-center justify-content-between px-4 px-md-5">
      <!--Left-->
      <div class="left-content">
        <div class="logo-wrap">
          <img src="/images/logo.png" alt="Budget Buddy Logo">
          <h2 class="brand-name">Budget <span>Buddy</span></h2>
        </div>

        <h1 class="main-heading">Plan, Save, and Track with Ease</h1>
        <p class="sub-heading">Track your expenses and manage your budget easily!</p>
      </div>
      <!--Right-->
      <div class="login-box p-4 shadow text-center">
        <h2 class="heading mb-4">Login</h2>
        <form action="/loginUser" method="post" class="w-100" style="max-width: 400px; margin: auto;">
          <div class="mb-3">
            <input type="email" name="email" class="form-control w-85 mx-auto py-2 rounded-pill border-0 shadow-sm"
              placeholder="Email" value="<%=formData.email%>">
          </div>
          <div class="mb-3 position-relative w-85 mx-auto">
            <input type="password" name="password" id="passwordInput"
              class="form-control py-2 rounded-pill border-0 shadow-sm pe-5" placeholder="Password">
            <i class="bi bi-eye-slash" id="togglePassword"
              style="position: absolute;right: 20px;top: 50%;transform: translateY(-50%);cursor: pointer;font-size: 1.1rem;color: #da6220; ">
            </i>
          </div>
          <div class="w-85 mx-auto d-flex justify-content-end mb-3">
            <a href="/forgetPassword" class="anchorText text-decoration-none small fw-semibold">Forget Password</a>
          </div>
          <button type="submit"
            class="btn btn-primary rounded-pill py-2 px-5 fw-semibold shadow-sm hover-grow">Login</button>
          <p class="text-light mt-4 small">
            New here? <a href="/signup" class="anchorText text-decoration-none">Sign Up</a>
          </p>
        </form>
      </div>
    </div>
    <script src="/js/script.js"></script>
    <script src="/js/userScript.js"></script>
    <script>
      history.pushState(null, null, location.href);
      window.onpopstate = function () {
        history.go(1);
      };
    </script>

</body>

</html>