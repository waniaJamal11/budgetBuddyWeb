<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forget Password - Budget Buddy</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/signupStyle.css" />
  <link rel="stylesheet" href="/css/common.css" />
</head>

<body class="bg d-flex justify-content-center align-items-center min-vh-100">
  <%- include("../partials/flashMessages.ejs") %>

  <div class="Contain shadow p-4 d-flex flex-column align-items-center justify-content-center text-center">

    <h1 class="heading mt-3 mb-4">Forgot Password</h1>

    <form action="/forgetPassword" method="POST" class="w-100" style="max-width: 400px;" >

      <% if (!emailExists) { %>
        <div id="emailSection" class="mb-3">
          <input
            id="emailInput"
            name="email"
            type="email"
            class="form-control py-2 rounded-pill border-0 shadow-sm"
            placeholder="Enter registered email"
            value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
          />
          <button type="submit"
                  class="btn btn-primary rounded-pill py-2 px-5 fw-semibold shadow-sm w-100 mt-3">
            Check Email
          </button>
        </div>
      <% } %>

      <% if (emailExists) { %>
        <input type="hidden" name="email" value="<%= formData.email %>" />

        <div id="passwordSection" class="mt-3">
          <div class="mb-3 position-relative">
            <input
              id="passwordInput"
              name="password"
              type="password"
              class="form-control py-2 rounded-pill border-0 shadow-sm mb-3"
              placeholder="New password"
            />
            <i class="bi bi-eye-slash" id="togglePassword"
               style="position:absolute;right:20px;top:50%;transform:translateY(-50%);cursor:pointer;color:#da6220;font-size:1.1rem;"></i>
          </div>

          <div class="mb-3 position-relative">
            <input
              id="confirmPasswordInput"
              name="confirmPassword"
              type="password"
              class="form-control py-2 rounded-pill border-0 shadow-sm mb-3"
              placeholder="Confirm password"
            />
            <i class="bi bi-eye-slash" id="toggleConfirmPassword"
               style="position:absolute;right:20px;top:50%;transform:translateY(-50%);cursor:pointer;color:#da6220;font-size:1.1rem;"></i>
          </div>

          <button type="submit" class="btn btn-primary rounded-pill py-2 px-5 fw-semibold shadow-sm w-100">
            Update Password
          </button>
        </div>
      <% } %>

    </form>

    <p class="text-light mt-4 small">
      Back to <a href="/" class="anchorText text-decoration-none">Login</a>
    </p>

  </div>

  <script src="/js/script.js"></script>
  <script src="/js/userScript.js"></script>
  <script>
    history.pushState(null, null, location.href);
    window.onpopstate = function () { history.go(1); };
  </script>

</body>
</html>
