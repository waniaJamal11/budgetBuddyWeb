<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catagories - Budget Buddy</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/categoryStyle.css">
</head>

<body>
    <%- include("../partials/flashMessages.ejs") %>
        <%- include("../partials/navbar.ejs") %>
            <main class="container my-4">
                <div class="row mb-3">
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center">
                            <h2 class="fw-bold text-blue headingSize">Categories</h2>       
                            <button id="openAddCategoryBtn" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Add Category</button>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light table-custom-heading">
                                    <tr>
                                        <th></th>
                                        <th>Category Name</th>
                                        <th>Transaction Type</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if(category.length>0){ %>
                                        <% category.forEach(function(category, index) {%>
                                            <tr>
                                                <td>
                                                    <%= index+1 %>
                                                </td>
                                                <td>
                                                    <%= category.name%>
                                                </td>
                                                <td>
                                                    <%= category.transactionType.name %>
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-primary me-1 edit-btn"
                                                        data-id="<%= category._id %>" data-name="<%= category.name %>"
                                                        data-type="<%= category.transactionType.name %>">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>



                                                    <form action="/deleteCategory/<%= category._id%>" method="post"
                                                        style="display: inline-block;">
                                                        <button type="submit" class="btn btn-sm btn-danger delete-btn" data-type="category"
                                                            data-name="<%= category.name %>">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                            <% }); %>
                                                <% }else{ %>
                                                    <td class="msg" colspan="4">
                                                        <p class="text-danger">No categories found yet</p>
                                                        <p class="text-muted">Click the "Add Category" button to get
                                                            started</p>
                                                    </td>
                                                    <% } %>
                                </tbody>
                            </table>
                            <!-- add -->
                            <%-include("addCategory.ejs") %>
                                <!--update-->
                                <%-include("editCategory.ejs") %>
                        </div>
                    </div>
                </div>
                <!-- delete --->
                <%-include("deleteCategory.ejs") %>
            </main>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
            <script src="/js/script.js"></script>
</body>

</html>