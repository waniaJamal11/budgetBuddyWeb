<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catagories - Budget Buddy</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/categoryStyle.css">
</head>

<body>
    <%- include("../partials/flashMessages.ejs") %>
        <%- include("../partials/navbar.ejs") %>
            <main class="container my-4">
                <div class="row mb-3">
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center">
                            <h2 class="fw-bold text-blue headingSize">Categories</h2>
                            <a href="/addCategories" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Add
                                Category</a>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light table-custom-heading">
                                    <tr>
                                        <th></th>
                                        <th>Category Name</th>
                                        <th>Transaction Type</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if(category.length>0){ %>
                                        <% category.forEach(function(catagory, index) {%>
                                            <tr>
                                                <td>
                                                    <%= index+1 %>
                                                </td>
                                                <td>
                                                    <%= catagory.name%>
                                                </td>
                                                <td>
                                                    <%= catagory.transactionType.name %>
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-primary me-1">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-danger">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                            <% }); %>
                                                <% }else{ %>
                                                    <td class="msg" colspan="4">
                                                    <p style="color: red;">No categories found yet</p>
                                                    <p class="text-muted">Click the "Add Category" button to get started</p>
                                                    </td>
                                              <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>
            <script src="/js/script.js"></script>
</body>

</html>