<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Budget Buddy</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/dashboardStyle.css">
  <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
</head>

<body>
  <%- include("../partials/flashMessages") %>
    <%- include("../partials/navbar") %>

      <main class="container my-4">
        <div class="row">
          <div class="col-12 text-center mb-4">
            <img src="/images/welcome.png" alt="Welcome" class="img-fluid welcome-img">
          </div>
        </div>

        <div class="row">
          <div class="col-12">
            <div class="user-name mb-3">
              <h1 class="fw-bold">
                <%= user.name %>
              </h1>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-lg-8 col-md-7">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <p class="activityHeading fw-semibold mb-0">Activity</p>
              <div class="dropdown filter-dropdown">
                <button class="filter-btn" type="button" id="filterMenuButton">
                  <i class="bi bi-filter"></i> <span id="selectedFilter">
                    <%= filter.charAt(0).toUpperCase() + filter.slice(1) %>
                  </span>
                </button>
                <ul class="searchDropdown-menu" id="filterMenu">
                  <li data-value="daily">Daily</li>
                  <li data-value="weekly">Weekly</li>
                  <li data-value="monthly">Monthly</li>
                </ul>
              </div>
              <form id="filterForm" method="GET" style="display:none;">
                <input type="hidden" name="filter" id="hiddenFilterInput" value="<%= filter %>">
              </form>


            </div>

            <div class="activity-list d-flex flex-column gap-3">
              <% if (transactions && transactions.length> 0) { %>
                <% transactions.forEach(tx=> { %>
                  <div class="card shadow-sm border-0 p-3">
                    <div class="d-flex justify-content-between align-items-center">
                      <span class="fw-semibold">
                        <%= tx.categoryId?.name %>
                      </span>
                      <% if (tx.transactionTypeId?.name==='Income' ) { %>
                        <span class="fw-bold text-success">+ Rs. <%= tx.amount %></span>
                        <% } else { %>
                          <span class="fw-bold text-danger">- Rs. <%= tx.amount %></span>
                          <% } %>
                    </div>
                  </div>
                  <% }) %>
                    <% } else { %>
                      <div class="no-transactions text-center my-4">
                        <div class="icon">&#128269;</div>
                        <p class="text-danger">No transactions!</p>
                        <p class="text-muted">
                         Add <span class="highlight" onclick="window.location.href='/categories'">+ New Category</span>
                         and start your budget tracking
                         </p>
                      </div>
                      <% } %>
            </div>
          </div>

          <div class="col-lg-4 col-md-5 mt-4 mt-md-0">
            <div class="wallet-box card shadow border-0 p-5 text-center">
              <h5 class="textColor mb-3">Total Balance</h5>
              <h2 class="fw-bold">Rs. <%= totalBalance %>
              </h2>
            </div>

            <% if (pieData && pieData.length> 0) { %>
              <div class="mt-3">
                <canvas id="expensePieChart" width="220" height="220"></canvas>
                <div id="chartData" data-labels='<%- JSON.stringify(pieLabels) %>'
                  data-values='<%- JSON.stringify(pieData) %>'>
                </div>
              </div>
              <% } %>
          </div>
        </div>
      </main>

      <a href="/addTransaction" class="add-transaction-btn">
        <i class="bi bi-plus-lg"></i>
      </a>
      <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
      <script src="/js/dashboardScript.js"></script>
      <script src="/js/script.js"></script>
      <script src="/js/transactionScript.js"></script>
      <script>
        history.pushState(null, null, location.href);
        window.onpopstate = function () {
          history.go(1);
        };
      </script>


</body>

</html>