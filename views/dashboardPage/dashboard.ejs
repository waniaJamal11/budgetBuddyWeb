<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Budget Buddy</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/dashboardStyle.css">
</head>

<body>
  <%- include("../partials/flashMessages") %>
  <%- include("../partials/navbar") %>
    <main class="container my-4">
      <div class="row">
        <div class="col-12 text-center mb-4">
          <img src="/images/welcome.png" alt="Welcome" class="img-fluid welcome-img">
        </div>
      </div>

      <div class="row">
        <div class="col-12">
          <div class="user-name mb-3">
            <h1 class="fw-bold">Wania Jamal</h1>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-lg-8 col-md-7">
          <p class="activityHeading fw-semibold mb-3">Today's Activity</p>

          <div class="activity-list d-flex flex-column gap-3">
            <div class="card shadow-sm border-0 p-3">
              <div class="d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Bills</span>
                <span class="fw-bold text-danger">- Rs. 2,500</span>
              </div>
            </div>

            <div class="card shadow-sm border-0 p-3">
              <div class="d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Salary</span>
                <span class="fw-bold text-success">+ Rs. 25,000</span>
              </div>
            </div>

            <div class="card shadow-sm border-0 p-3">
              <div class="d-flex justify-content-between align-items-center">
                <span class="fw-semibold ">Food</span>
                <span class="fw-bold text-danger">- Rs. 800</span>
              </div>
            </div>

            <div class="card shadow-sm border-0 p-3">
              <div class="d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Transport</span>
                <span class="fw-bold text-danger">- Rs. 400</span>
              </div>
            </div>

            <div class="card shadow-sm border-0 p-3">
              <div class="d-flex justify-content-between align-items-center">
                <span class="fw-semibold ">Freelance</span>
                <span class="fw-bold text-success">+ Rs. 5,000</span>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-5 mt-4 mt-md-0">
          <div class="wallet-box card shadow border-0 p-5 text-center">
            <h5 class="textColor mb-3">Total Balance</h5>
            <h2 class="fw-bold">Rs. 26,300</h2>
          </div>

          <div class="text-center mt-3">
            <canvas id="expensePieChart" width="220" height="220"></canvas>
          </div>
        </div>

      </div>
      </div>
      </div>
    </main>
    <a href="/addTransaction" class=" add-transaction-btn">
  <i class="bi bi-plus-lg"></i>
    </a>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/script.js"></script>
</body>

</html>